+bool UAkComponent::SeekOnEventByPct( class UAkAudioEvent * AkEvent, float Percent, bool SeekToNearestMarker, int32 PlayingID /*= AK_INVALID_PLAYING_ID*/ )
+{
+	AkReal32 pct = Percent;
+
